# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env*/
.python-version

# Notebooks
.ipynb_checkpoints/

# Large data — traces are downloaded, never committed
data/
workloads/raw/
*.parquet
*.csv.gz
*.jsonl.gz

# Raw experiment output: keep the directory, not multi-GB artefacts.
# Committed result artefacts must be added explicitly with `git add -f`.
results/**
!results/.gitkeep
!results/**/README.md

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# M1 spike working area: third-party simulator clones, venvs, build output.
# Cloned by hand per docs/spike/, never committed (see REPRODUCE.md).
.spike/

# Derived workloads: regenerate with `python workloads/build_workloads.py`.
# The .manifest.json sidecars ARE committed — they carry provenance, the
# upstream SHA-256 and the measured realised sharing, which is the evidence.
workloads/derived/*.jsonl
!workloads/derived/*.manifest.json
